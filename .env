# Flowise Environment Configuration with Authentication

PORT=3000
FLOWISE_PATH=/root/.flowise

# Flowise Authentication Credentials
FLOWISE_USERNAME=admin@flowise.local
FLOWISE_PASSWORD=FlowiseAdmin123!

# Security & Encryption Keys
EXPRESS_SESSION_SECRET=flowise_session_secret_key_12345
FLOWISE_SECRETKEY_OVERWRITE=flowise_encryption_key_67890

# Optional CORS Configuration
# CORS_ORIGINS=*

# Optional API Keys (Can also be added directly in the Flowise UI Credentials section)
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GOOGLE_API_KEY=your-google-gemini-api-key
